---
layout: none
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//TCS seminar//EN
X-WR-CALNAME:Liquidshop
METHOD:PUBLISH
{% for talk in site.data.ls6.talks %}{% assign nexttalk = site.data.ls6.talks[forloop.index] %}BEGIN:VEVENT
UID:ls6-{{talk.time | replace: ":",""}}@liquidsoap.info
ORGANIZER;CN="Liquidshop":MAILTO:liquidshop@liquidsoap.info
LOCATION:http://bbb.liquidsoap.info/
SUMMARY:Liquidshop: {% if talk.lastname %}{{talk.firstname}} {{talk.lastname}} / {% endif %}{{talk.title | replace: ",","\,"}}
DESCRIPTION:{{talk.abstract | strip_newline | replace: ",","\,"}}
CLASS:PUBLIC
DTSTART:20260529T{{talk.time | replace: ":",""}}00Z
DTEND:20260529T{% if nexttalk.time %}{{nexttalk.time | replace: ":",""}}{% else %}{{talk.time | replace: ":",""}}{% endif %}00Z
DTSTAMP:20260529T{{talk.time | replace: ":",""}}00Z
SEQUENCE:{{site.time | date: "%s"}}
END:VEVENT
{% endfor %}END:VCALENDAR
